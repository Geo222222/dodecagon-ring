# Gate trust map: JSON object of caller-id -> PEM public key.
DODECAGON_TRUSTED_CALLERS_JSON={}

# Shiloh can possess an identity key for signed read/propose calls.
# It is not an execution/root key.
SHILOH_PRIVATE_KEY_PEM=
REUBEN_BASE_URL=http://127.0.0.1:4101

# GitHub Actions Root Authority verification key is configured as a repository/environment secret:
# ROOT_AUTHORITY_PUBLIC_KEY_PEM
