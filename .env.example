# Repository identity bound into Root Authority approvals.
DODECAGON_REPOSITORY=Geo222222/dodecagon-ring

# Trust map of caller-id -> PEM public key. Include every active Gate, Shiloh, and external:github-actions.
DODECAGON_TRUSTED_CALLERS_JSON={}

# Shared border tolerance. Production values must remain between 1s and 5m.
DODECAGON_MAX_CLOCK_SKEW_MS=60000

# Each sovereign Gate receives only its own service identity private key.
DODECAGON_GATE_PRIVATE_KEY_PEM=

# Shiloh identity signs read/propose calls only. It is not an execution or Root key.
SHILOH_PRIVATE_KEY_PEM=

# Reuben PostgreSQL foundation and boundary endpoint.
DATABASE_URL=postgresql://dodecagon:change-me@127.0.0.1:5432/dodecagon
REUBEN_BASE_URL=http://127.0.0.1:4101

# Public verification material only. Root private key must never be placed here.
ROOT_AUTHORITY_PUBLIC_KEY_PEM=

# GitHub Actions uses a separate non-Root service identity to submit already Root-signed approvals to Reuben.
# Configure its private key as DODECAGON_WORKFLOW_PRIVATE_KEY_PEM in GitHub secrets and its public key
# under external:github-actions in DODECAGON_TRUSTED_CALLERS_JSON.
